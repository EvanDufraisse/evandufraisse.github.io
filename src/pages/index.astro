---

import MainGridLayout from '../layouts/MainGridLayout.astro'

import { getEntry } from 'astro:content'
import { i18n } from '../i18n/translation'
import I18nKey from '../i18n/i18nKey'
import Markdown from '@components/misc/Markdown.astro'

const aboutBlog = await getEntry('spec', 'aboutblog')
const aboutMe = await getEntry('spec', 'aboutme')
const hiCard = await getEntry('spec', 'hi')

const { Content: AboutBlog } = await aboutBlog.render()
const { Content: AboutMe } = await aboutMe.render()
const { Content: HiContent } = await hiCard.render()
---

<MainGridLayout title="Welcome" description="Welcome to My Blog!">
    <div class="flex flex-col gap-6 w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full">
            <Markdown class="mt-2 text-xl">
                <HiContent />
            </Markdown>
        </div>
        <div class="card-base z-10 px-9 py-6 relative w-full">
            <Markdown class="mt-2 text-xl">
                <AboutBlog />
            </Markdown>
        </div>
        <div class="card-base z-10 px-9 py-6 relative w-full">
            <Markdown class="mt-2 text-xl">
                <AboutMe />
            </Markdown>
        </div>
    </div>
</MainGridLayout>