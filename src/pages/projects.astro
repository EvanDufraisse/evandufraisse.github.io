---
import MainGridLayout from '../layouts/MainGridLayout.astro'

const projects = [
  { id: 1, title: "Agent Self-Hosting Project", description: "A journey to self-hosting savy agents", image: "/images/selfhosted/project_agent_banner.png" },
  { id: 2, title: "Song Recommender System", description: "Do away with collaborative-filtering", image: "/images/song_recommender/song_recommender_system_banner.png" },
  { id: 3, title: "News Summarizer", description: "Get aggregate news udpates", image: "/images/news_summarizer/news_summarizer_banner.jpg" }, 
];
---

<script>
function initializeSidebarSticky() {
  const stickySidebar = document.getElementById("sidebar-sticky");
  if (stickySidebar) {
    const url = window.location.pathname;
    console.log(url);
    if (url.endsWith("/blog") || url.endsWith("/blog/")) {
      stickySidebar.style.display = "flex";
    } else {
      stickySidebar.style.display = "none";
    }
  } else {
    console.warn('Element with id "sidebar-sticky" not found.');
  }
}

// Attach the function to run after content is swapped
document.addEventListener("astro:after-swap", initializeSidebarSticky);

// Run the function on the initial page load
initializeSidebarSticky();

</script>

<MainGridLayout>
<div class="gallery">
  {projects.map(project => (
    <a href="http://localhost:4321/projects" aria-label={project.title}>
    <div class="project-card" key={project.id}>
      <img src={project.image} alt={project.title} class="project-image" />
      <h3 class="project-title">{project.title}</h3>
      <p class="project-description">{project.description}</p>
    </div>
    </a>
  ))}
</div>
</MainGridLayout>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 16px;
    padding: 16px;
  }
  .project-card {
    border: 1px solid #ccc;
    border-radius: 8px;
    padding: 16px;
    text-align: center;
    background-color: #fff;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }
  .project-card:hover {
    border-color: #3b82f6;
  }
  .project-image {
    width: 100%;
    height: auto;
    border-radius: 4px;
    object-fit: cover;
    aspect-ratio: 1280 / 600;
  }
  .project-title {
    margin: 12px 0 8px;
    font-size: 1.25em;
  }
  .project-description {
    color: #555;
    font-size: 1em;
  }
</style>