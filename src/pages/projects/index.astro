---
// Import necessary components and functions
import MainGridLayout from '../../layouts/MainGridLayout.astro'
import { getCollection } from 'astro:content'
import Markdown from '@components/misc/Markdown.astro'
import { getEntry } from 'astro:content'

const about = await getEntry('spec', 'about')
const { Content: About } = await about.render()

// Fetch the projects collection
const projects = await getCollection('projects', ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true
})
---


<MainGridLayout>
<div class="flex flex-col gap-6 w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
 <div class="card-base z-10 px-9 py-6 relative w-full">
            <Markdown class="mt-2 text-xl">
                <About />
            </Markdown>
        </div>
  <div class="gallery">
    {projects.map(project => (
      <a href={`/projects/${project.slug}`} aria-label={project.data.title}
         class="dark:hover:border-gray-200 dark:border-gray-500 hover:border-blue-200 border-stone-100 border-2 dark:border-0.5 block rounded-lg w-1/2"
      >
        <div class="project-card dark:project-card bg-[var(--card-bg)]" 
             style="border: 1px; border-radius: 8px; padding: 16px; text-align: center;"
             key={project.id}>
          <img src={project.data.banner} alt={project.data.title} class="project-image" style="margin-bottom: 8px;" />
          <p class="project-title text-xl text-black/100 dark:text-white/90 transition" style="text-align: center">{project.data.title}</p>
          <p class="project-description text-black/80 dark:text-white/70 text-lg transition">{project.data.description}</p>
        </div>
      </a>
    ))}
  </div>
  </div>
</MainGridLayout>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 16px;
    padding: 16px;
  }
  .project-image {
    width: 100%;
    height: auto;
    border-radius: 4px;
    object-fit: cover;
    aspect-ratio: 1280 / 600;
  }
</style>