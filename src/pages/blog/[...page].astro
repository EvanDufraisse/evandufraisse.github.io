---
import type { GetStaticPaths } from 'astro'
import PostPage from '../../components/PostPage.astro'
import Pagination from '../../components/control/Pagination.astro'
import { PAGE_SIZE } from '../../constants/constants'
import MainGridLayout from '../../layouts/MainGridLayout.astro'
import { getSortedPosts } from '../../utils/content-utils'
import Tag from '@components/widget/Tags.astro'
import Categories from '@components/widget/Categories.astro'
export const getStaticPaths = (async ({ paginate }) => {
  const allBlogPosts = await getSortedPosts()
  return paginate(allBlogPosts, { pageSize: PAGE_SIZE })
}) satisfies GetStaticPaths
// https://github.com/withastro/astro/issues/6507#issuecomment-1489916992

const { page } = Astro.props

const len = page.data.length
---

<script>
function initializeSidebarSticky() {
  const stickySidebar = document.getElementById("sidebar-sticky");
  if (stickySidebar) {
    const url = window.location.pathname;
    console.log(url);
    if (url.endsWith("/blog") || url.endsWith("/blog/")) {
      stickySidebar.style.display = "flex";
    } else {
      stickySidebar.style.display = "none";
    }
  } else {
    console.warn('Element with id "sidebar-sticky" not found.');
  }
}

// Attach the function to run after content is swapped
document.addEventListener("astro:after-swap", initializeSidebarSticky);

// Run the function on the initial page load
initializeSidebarSticky();

</script>

<MainGridLayout>
    <PostPage page={page}></PostPage>
    <Pagination class="mx-auto onload-animation" page={page} style=`animation-delay: calc(var(--content-delay) + ${(len)*50}ms)`></Pagination>
</MainGridLayout>